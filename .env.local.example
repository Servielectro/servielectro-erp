NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Google AI Studio (Gemini): el ÚNICO proveedor de IA del ERP.
# Se usa solo en src/lib/ia/gemini.ts, llamado desde Server Actions para:
#   - leer el RUT del cliente (src/lib/documentos/extraer-rut.ts)
#   - buscar en la web la referencia de un EQUIPO y proponer su descripción
#     (src/lib/catalogo/describir-equipo.ts)
# NUNCA con prefijo NEXT_PUBLIC_. Jhojan la carga en Vercel (Settings →
# Environment Variables → Secret → Production).
GEMINI_API_KEY=

# Server-only. Clave secreta de Supabase, solo para crear usuarios desde
# Configuración → Usuarios (src/lib/supabase/admin.ts). NUNCA con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
