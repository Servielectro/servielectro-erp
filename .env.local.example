NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NUNCA con prefijo NEXT_PUBLIC_ — se usaría en el navegador y quedaría
# expuesta. Se usa solo dentro de src/lib/documentos/extraer-rut.ts (Server Action),
# para leer el RUT del cliente con IA. Jhojan la carga él mismo (ver README).
OPENAI_API_KEY=

# Server-only. Google AI Studio (Gemini). Se usa solo en
# src/lib/catalogo/describir-equipo.ts (Server Action) para buscar en la web la
# referencia de un EQUIPO y proponer su descripción en la cotización.
# NUNCA con prefijo NEXT_PUBLIC_. Jhojan la carga en Vercel (Settings →
# Environment Variables → Secret → Production).
GEMINI_API_KEY=
